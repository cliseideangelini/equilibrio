// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL") // Uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // Uses a direct connection
}

enum AppointmentType {
  ONLINE
  PRESENCIAL
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ABSENT
  COMPLETED
}

model Psychologist {
  id                     String         @id @default(cuid())
  name                   String
  email                  String         @unique
  username               String?        @unique
  password               String         // Senha criptografada
  crp                    String
  bio                    String
  phone                  String?
  whatsappNotifications  Boolean        @default(false)
  whatsappNumber         String?
  whatsappApiKey         String?
  resetToken             String?        @unique
  resetTokenExpiry       DateTime?
  isSchedulePaused       Boolean        @default(false)
  availabilities         Availability[]
  appointments           Appointment[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model Availability {
  id             String       @id @default(cuid())
  dayOfWeek      Int          // 0 = Domingo, 1 = Segunda...
  startTime      Int          // Minutos desde a meia-noite
  endTime        Int          // Minutos desde a meia-noite
  psychologist   Psychologist @relation(fields: [psychologistId], references: [id])
  psychologistId String
}

model Patient {
  id                 String        @id @default(cuid())
  name               String
  email              String?       @unique
  phone              String        @unique
  password           String?       // Senha criptografada
  mustChangePassword Boolean       @default(false)
  dateOfBirth        DateTime?
  username           String?       @unique
  resetToken         String?       @unique
  resetTokenExpiry   DateTime?
  appointments       Appointment[]
  evolutions         Evolution[]
  attachments        Attachment[]
  isFixed            Boolean       @default(false)
  fixedDayOfWeek     Int?          // 0-6
  fixedTime          String?       // HH:mm
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Appointment {
  id             String            @id @default(cuid())
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(PENDING)
  type           AppointmentType   @default(ONLINE)
  meetLink       String?
  psychologist   Psychologist      @relation(fields: [psychologistId], references: [id])
  psychologistId String
  patient        Patient           @relation(fields: [patientId], references: [id])
  patientId      String
  payment        Payment?
  evolution      Evolution?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Evolution {
  id            String      @id @default(cuid())
  content       String      @db.Text
  patient       Patient     @relation(fields: [patientId], references: [id])
  patientId     String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId String      @unique
  date          DateTime    @default(now())
  isDraft       Boolean     @default(false)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  createdAt DateTime @default(now())
}

model Payment {
  id            String    @id @default(cuid())
  amount        Float
  status        String    // PAID, PENDING, REFUNDED
  method        String?   // PIX, CARD, etc
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId String    @unique
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
}

model WaitingList {
  id             String    @id @default(cuid())
  name           String
  phone          String
  email          String?
  preferredDays  String?
  preferredHours String?
  specificDate   DateTime?
  specificTime   String?
  status         String    @default("PENDING") // PENDING, NOTIFIED, BOOKED, CANCELLED
  preferredShift String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model WhatsAppSession {
  id        String   @id @default(cuid())
  phone     String   @unique
  state     String   @default("MENU") // MENU, SCHEDULING, TRANSBORDO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
